#!/usr/bin/env bash
# claude-box — run Claude Code in the cage (see libcage.sh) with
# --dangerously-skip-permissions.
#
# Mounts the project dir at its exact host path so skill symlinks resolve.
# Persists Claude Code state (settings, conversations) in ~/.claude-box/state/
# across runs — delete that dir to reset. Syncs ~/.claude skills, plugins, hooks,
# and .mcp.json into the container. Sessions for the current project are shared
# with the host's ~/.claude/projects/<slug>/ so they're resumable from host
# Claude too, along with session-keyed satellite state (todos, shell env, pastes,
# plans, file-history).
#
# Always runs in the current directory (the project root). cd into your project
# first, then:
#   claude-box                  # interactive session
#   claude-box -c               # continue most recent session here
#   claude-box --resume         # interactive session picker
#   claude-box -r <id>          # resume a specific session by ID
#   claude-box -p "..."         # non-interactive prompt (pipe-friendly)
#
# Every argument is passed straight through to claude. Use `--` to force
# everything after it to claude.
#
# claude-box-specific flags (consumed before claude sees them; position-free):
#   --ollama <model>            # route Claude Code at an Ollama server's
#                                 Anthropic-compatible API (base URL from
#                                 OLLAMA_HOST)
# plus the cage-generic flags (see libcage.sh / README):
#   --no-ssh / --upgrade / --engine <mode> / --name <name> / --name-file <path>
#
# Installation:
#   git clone https://github.com/shftwst/claude-box ~/claude-box
#   ln -sf ~/claude-box/claude-box /usr/local/bin/claude-box

set -euo pipefail

# Resolve symlinks so an install via `ln -sf` still finds the repo dir.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self")
  [[ "$_link" = /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
BOX_SRC_DIR="$(cd "$(dirname "$_self")" && pwd)"

CLAUDE_HOME="${HOME}/.claude"

# --- cage config ---
BOX_LABEL="claude-box"
BOX_IMAGE="claude-box"
BOX_DOCKERFILE="${BOX_SRC_DIR}/Dockerfile.claude"
BOX_STATE_DIR="${HOME}/.claude-box/state"
BOX_STATE_MOUNT="${CLAUDE_HOME}"
BOX_ENV_PREFIX="CLAUDE_BOX"
BOX_FORWARD_VARS=(ANTHROPIC_API_KEY LINEAR_API_KEY)
BOX_PAYLOAD_CMD=(claude --dangerously-skip-permissions)
# Extra files Dockerfile.claude COPYs, so editing them forces an image rebuild.
BOX_BUILD_INPUTS=("${BOX_SRC_DIR}/payload-init-claude.sh" "${BOX_SRC_DIR}/claude-box-theme.json")

OLLAMA_MODEL=""

# shellcheck source=libcage.sh
source "${BOX_SRC_DIR}/libcage.sh"

# --- wrapper flag: --ollama <model> ---
box_parse_arg() {
  case "$1" in
    --ollama)
      OLLAMA_MODEL="${2:-}"
      [[ -n "$OLLAMA_MODEL" ]] || { printf '[claude-box] --ollama requires a model name\n' >&2; exit 1; }
      _CONSUMED=2; return 0 ;;
    --ollama=*) OLLAMA_MODEL="${1#*=}"; _CONSUMED=1; return 0 ;;
  esac
  return 1
}

# Echoes a claudeAiOauth credential's expiresAt (epoch ms) from stdin, else 0.
_cred_expiry() {
  node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);process.stdout.write(String((j.claudeAiOauth&&j.claudeAiOauth.expiresAt)||0))}catch{process.stdout.write("0")}})' 2>/dev/null || printf 0
}

# --- box_stage: everything Claude-specific, run after the cage builds its
# generic mounts and before the (generic) colima flush. Appends to env_args /
# override_mounts (cage globals), stages files into STATE_DIR / RELAY_DIR, and
# sets HOST_PROJECT_SESSIONS for box_sync_back.
box_stage() {
  local STATE_CLAUDE_JSON="${STATE_DIR}/.claude.json"

  # claude-code: skip its npm self-install on startup.
  env_args+=(-e "SKIP_NPM_PACKAGES_INSTALL=1")

  # --ollama <model>: route Claude Code at an Ollama server's Anthropic-compatible
  # API. Base URL from OLLAMA_HOST (scheme optional). ANTHROPIC_AUTH_TOKEN is a
  # dummy Ollama ignores but Claude Code requires non-empty. Both main and
  # small/fast models point at the same model.
  if [[ -n "$OLLAMA_MODEL" ]]; then
    local _ollama_url="${OLLAMA_HOST:-localhost:11434}"
    [[ "$_ollama_url" == http://* || "$_ollama_url" == https://* ]] || _ollama_url="http://${_ollama_url}"
    env_args+=(
      -e "ANTHROPIC_BASE_URL=${_ollama_url}"
      -e "ANTHROPIC_AUTH_TOKEN=ollama"
      -e "ANTHROPIC_MODEL=${OLLAMA_MODEL}"
      -e "ANTHROPIC_SMALL_FAST_MODEL=${OLLAMA_MODEL}"
    )
    log "ollama mode: ${_ollama_url} (model: ${OLLAMA_MODEL})"
  fi

  # Concatenate CLAUDE.md: global base -> parent dirs -> project (project wins).
  # Written into the state dir so it's part of the main volume mount.
  : > "${STATE_DIR}/CLAUDE.md"
  [[ -f "${CLAUDE_HOME}/CLAUDE.md" ]] && cat "${CLAUDE_HOME}/CLAUDE.md" >> "${STATE_DIR}/CLAUDE.md"
  local claude_files=() current="$PROJECT_DIR" i f
  while [[ "$current" != "/" ]]; do
    [[ -f "$current/CLAUDE.md" ]] && claude_files+=("$current/CLAUDE.md")
    current="$(dirname "$current")"
  done
  for (( i=${#claude_files[@]}-1; i>=0; i-- )); do
    f="${claude_files[$i]}"
    printf '\n<!-- %s -->\n' "$f" >> "${STATE_DIR}/CLAUDE.md"
    cat "$f" >> "${STATE_DIR}/CLAUDE.md"
  done

  # Concatenate AGENTS.md the same way into the cage relay (the entrypoint copies
  # it to ~/.agents/AGENTS.md). Skip if the cage couldn't provide a writable relay.
  if [[ -n "$RELAY_DIR" ]]; then
    : > "${RELAY_DIR}/AGENTS.md"
    [[ -f "${HOME}/.agents/AGENTS.md" ]] && cat "${HOME}/.agents/AGENTS.md" >> "${RELAY_DIR}/AGENTS.md"
    local agents_files=()
    current="$PROJECT_DIR"
    while [[ "$current" != "/" ]]; do
      [[ -f "$current/AGENTS.md" ]] && agents_files+=("$current/AGENTS.md")
      current="$(dirname "$current")"
    done
    for (( i=${#agents_files[@]}-1; i>=0; i-- )); do
      f="${agents_files[$i]}"
      printf '\n<!-- %s -->\n' "$f" >> "${RELAY_DIR}/AGENTS.md"
      cat "$f" >> "${RELAY_DIR}/AGENTS.md"
    done
  fi

  # Extract gh CLI token and forward it as GH_TOKEN (cage forwards GH_TOKEN if
  # already set; this covers the keychain-backed macOS case). Harmless duplicate
  # of the cage's own gh fetch, kept for parity with the monolith.
  # (No-op here: the cage already fetched GH_TOKEN before box_stage.)

  # Per-project session sharing: bind-mount just this project's session dir so
  # sessions started in claude-box are resumable from host Claude and vice versa.
  # PROJECT_SLUG is set by the cage. HOST_PROJECT_SESSIONS is global for sync-back.
  HOST_PROJECT_SESSIONS="${CLAUDE_HOME}/projects/${PROJECT_SLUG}"
  mkdir -p "$HOST_PROJECT_SESSIONS"
  mkdir -p "${STATE_DIR}/projects/${PROJECT_SLUG}"

  # Surface the previous run's resume hint if the last session was dropped.
  local _last_resume_file="${STATE_DIR}/projects/${PROJECT_SLUG}/.last-resume"
  if [[ -s "$_last_resume_file" ]]; then
    log "last session: $(cat "$_last_resume_file")"
    rm -f "$_last_resume_file" 2>/dev/null || true
  fi
  if [[ "${DOCKER_HOST:-}" != */.colima/* ]]; then
    override_mounts+=(-v "${HOST_PROJECT_SESSIONS}:${HOST_PROJECT_SESSIONS}")
  fi

  # Session-keyed satellite state (todos, shell env, pastes, plans, file-history).
  local entry
  for entry in tasks session-env shell-snapshots paste-cache plans file-history; do
    mkdir -p "${CLAUDE_HOME}/${entry}"
    if [[ "${DOCKER_HOST:-}" != */.colima/* ]]; then
      override_mounts+=(-v "${CLAUDE_HOME}/${entry}:${CLAUDE_HOME}/${entry}")
    fi
  done

  # On non-Colima runtimes, overlay-mount host ~/.claude entries on top of the
  # state dir so the container reflects the host's current setup. On Colima these
  # mounts silently fail (virtiofs can't see host dirs), so sync into the state
  # dir instead (below), before the cage's flush.
  if [[ "${DOCKER_HOST:-}" != */.colima/* ]]; then
    for entry in plugins skills hooks .mcp.json; do
      if [[ -e "${CLAUDE_HOME}/${entry}" ]]; then
        if [[ -d "${CLAUDE_HOME}/${entry}" ]]; then mkdir -p "${STATE_DIR}/${entry}"; else touch "${STATE_DIR}/${entry}"; fi
        override_mounts+=(-v "${CLAUDE_HOME}/${entry}:${CLAUDE_HOME}/${entry}:rw")
      fi
    done
    # Symlinked skills point outside ~/.claude; mount their target parent dirs rw
    # so those paths resolve inside the container.
    log "resolving skill symlinks..."
    local dir target
    while IFS= read -r dir; do
      [[ -d "$dir" ]] && override_mounts+=(-v "${dir}:${dir}:rw")
    done < <(
      find "${CLAUDE_HOME}/skills" -maxdepth 1 -type l 2>/dev/null \
        | while IFS= read -r link; do target=$(readlink "$link" 2>/dev/null) && dirname "$target"; done \
        | sort -u
    )
  else
    log "resolving skill symlinks..."
  fi

  # Sync Claude OAuth credentials into the state dir, newer-wins by expiresAt. On
  # macOS the canonical source is the Keychain ("Claude Code-credentials");
  # ~/.claude/.credentials.json often holds only MCP OAuth state, so trusting the
  # file by existence would overwrite a good state token with garbage.
  log "reading Claude credentials..."
  local _state_cred="${STATE_DIR}/.credentials.json" _state_exp=0 KEYCHAIN_CRED _kc_exp
  if [[ -s "$_state_cred" ]] && grep -q '"claudeAiOauth"' "$_state_cred" 2>/dev/null; then
    _state_exp=$(_cred_expiry < "$_state_cred")
  fi
  if KEYCHAIN_CRED=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) \
     && [[ "$KEYCHAIN_CRED" == *claudeAiOauth* ]]; then
    _kc_exp=$(printf '%s' "$KEYCHAIN_CRED" | _cred_expiry)
    if [[ "${_kc_exp:-0}" -ge "${_state_exp:-0}" ]]; then
      printf '%s\n' "$KEYCHAIN_CRED" > "$_state_cred"
    fi
  elif [[ "${_state_exp:-0}" -eq 0 ]] && [[ -f "${CLAUDE_HOME}/.credentials.json" ]] \
       && grep -q '"claudeAiOauth"' "${CLAUDE_HOME}/.credentials.json" 2>/dev/null; then
    cp -f "${CLAUDE_HOME}/.credentials.json" "$_state_cred"
  fi

  # Prefer a long-lived OAuth token (claude setup-token) over the rotating
  # subscription refresh token so concurrent boxes don't revoke each other's
  # lineage. Skipped in ollama mode. Env token outranks the mounted credential.
  if [[ -z "$OLLAMA_MODEL" ]]; then
    local _claude_oauth_token="${CLAUDE_CODE_OAUTH_TOKEN:-}"
    if [[ -z "$_claude_oauth_token" ]] && command -v security >/dev/null 2>&1; then
      _claude_oauth_token=$(security find-generic-password -s "Claude Code-oauth-token" -w 2>/dev/null || true)
    fi
    if [[ -n "$_claude_oauth_token" ]]; then
      env_args+=(-e "CLAUDE_CODE_OAUTH_TOKEN=${_claude_oauth_token}")
      log "using static OAuth token (concurrency-safe; refresh disabled)"
    fi
  fi

  # Settings surgery: seed settings.json / .claude.json into the state dir (host
  # newer-wins), stripping sandbox/hooks, rewriting the macOS bun path to the
  # container path, forcing the claude-box theme, and pre-accepting the bypass
  # dialog. statusline mode refreshes the HUD every launch.
  local _sync_js="${TMPDIR:-/tmp}/claude-box-sync.$$.js"
  cat > "$_sync_js" <<'JSEOF'
const fs = require('fs');
const [,, mode, src, dst] = process.argv;
const s = JSON.parse(fs.readFileSync(src, 'utf8'));
if (mode === 'passthrough') {
  s.bypassPermissionsModeAccepted = true;
}
if (mode === 'settings') {
  delete s.sandbox;
  delete s.hooks;
  if (s.statusLine && s.statusLine.command) {
    s.statusLine.command = s.statusLine.command.replace(/\/opt\/homebrew\/bin\/bun/g, '/usr/local/bin/bun');
  }
  s.theme = 'custom:claude-box';
}
if (mode === 'statusline') {
  let cur;
  try { cur = JSON.parse(fs.readFileSync(dst, 'utf8')); } catch { process.exit(0); }
  if (s.statusLine) {
    const sl = JSON.parse(JSON.stringify(s.statusLine));
    if (sl.command) sl.command = sl.command.replace(/\/opt\/homebrew\/bin\/bun/g, '/usr/local/bin/bun');
    cur.statusLine = sl;
  } else {
    delete cur.statusLine;
  }
  cur.theme = 'custom:claude-box';
  fs.writeFileSync(dst, JSON.stringify(cur, null, 2));
  process.exit(0);
}
fs.writeFileSync(dst, JSON.stringify(s, null, 2));
JSEOF

  local HOST_SETTINGS="${CLAUDE_HOME}/settings.json" STATE_SETTINGS="${STATE_DIR}/settings.json"
  if [[ -f "$HOST_SETTINGS" ]] && { [[ ! -f "$STATE_SETTINGS" ]] || [[ "$HOST_SETTINGS" -nt "$STATE_SETTINGS" ]]; }; then
    node "$_sync_js" settings "$HOST_SETTINGS" "$STATE_SETTINGS"
  fi
  if [[ -f "$HOST_SETTINGS" && -f "$STATE_SETTINGS" ]]; then
    node "$_sync_js" statusline "$HOST_SETTINGS" "$STATE_SETTINGS"
  fi
  local HOST_CLAUDE_JSON="${HOME}/.claude.json"
  if [[ -f "$HOST_CLAUDE_JSON" ]] && { [[ ! -f "$STATE_CLAUDE_JSON" ]] || [[ "$HOST_CLAUDE_JSON" -nt "$STATE_CLAUDE_JSON" ]]; }; then
    node "$_sync_js" passthrough "$HOST_CLAUDE_JSON" "$STATE_CLAUDE_JSON"
  fi
  rm -f "$_sync_js"

  # Ensure all bind-mount source files exist as actual files (Docker auto-creates
  # missing sources as root-owned dirs, which persists and breaks later runs).
  local _f
  for _f in "$STATE_CLAUDE_JSON" "${STATE_DIR}/CLAUDE.md" "${STATE_DIR}/settings.json" \
            "${STATE_DIR}/.credentials.json"; do
    [[ -d "$_f" ]] && rm -rf "$_f"
    [[ ! -f "$_f" ]] && touch "$_f"
  done

  # On Colima, host overlay mounts fail, so sync host ~/.claude config + seed
  # sessions into the state dir here; the cage's flush (after box_stage) carries
  # it all into the VM.
  if [[ "${DOCKER_HOST:-}" == */.colima/* ]]; then
    log "syncing host config for colima..."
    local _sync_entry
    for _sync_entry in plugins skills hooks; do
      if [[ -d "${CLAUDE_HOME}/${_sync_entry}" ]]; then
        mkdir -p "${STATE_DIR}/${_sync_entry}"
        rsync -aL --delete "${CLAUDE_HOME}/${_sync_entry}/" "${STATE_DIR}/${_sync_entry}/" 2>/dev/null || \
          cp -rfL "${CLAUDE_HOME}/${_sync_entry}/." "${STATE_DIR}/${_sync_entry}/" 2>/dev/null || true
      fi
    done
    [[ -f "${CLAUDE_HOME}/.mcp.json" ]] && cp -f "${CLAUDE_HOME}/.mcp.json" "${STATE_DIR}/.mcp.json" 2>/dev/null || true

    log "seeding host sessions for colima..."
    if [[ -d "$HOST_PROJECT_SESSIONS" ]]; then
      rsync -au "${HOST_PROJECT_SESSIONS}/" "${STATE_DIR}/projects/${PROJECT_SLUG}/" 2>/dev/null || \
        cp -ru "${HOST_PROJECT_SESSIONS}/." "${STATE_DIR}/projects/${PROJECT_SLUG}/" 2>/dev/null || true
    fi
    local _seed_sat
    for _seed_sat in tasks session-env shell-snapshots paste-cache plans file-history; do
      if [[ -d "${CLAUDE_HOME}/${_seed_sat}" ]]; then
        mkdir -p "${STATE_DIR}/${_seed_sat}"
        rsync -au "${CLAUDE_HOME}/${_seed_sat}/" "${STATE_DIR}/${_seed_sat}/" 2>/dev/null || \
          cp -ru "${CLAUDE_HOME}/${_seed_sat}/." "${STATE_DIR}/${_seed_sat}/" 2>/dev/null || true
      fi
    done
  fi

  # Mount .claude.json (main state) at the home dir level.
  override_mounts+=(-v "${STATE_CLAUDE_JSON}:${HOME}/.claude.json")
}

# --- box_sync_back: flush sessions, credentials, and satellite state back to the
# host, write a refreshed token back to the Keychain, and print the resume hint.
# Runs from the cage's EXIT trap after the container has stopped; on colima the
# cage created _CID over the state volume for docker cp.
box_sync_back() {
  local _state_proj="${STATE_DIR}/projects/${PROJECT_SLUG}"

  if [[ -n "$_CID" ]]; then
    # Colima: copy out through Docker's I/O path (the host can't see it directly).
    log "syncing state back from colima..."
    docker cp "${_CID}:/_state/projects/${PROJECT_SLUG}/." "${_state_proj}/" 2>/dev/null || true
    docker cp "${_CID}:/_state/.claude.json" "${STATE_DIR}/.claude.json" 2>/dev/null || true
    docker cp "${_CID}:/_state/.credentials.json" "${STATE_DIR}/.credentials.json" 2>/dev/null || true
    local _sat
    for _sat in tasks session-env shell-snapshots paste-cache plans file-history; do
      docker cp "${_CID}:/_state/${_sat}/." "${STATE_DIR}/${_sat}/" 2>/dev/null || true
    done
  fi

  # Write an in-box token refresh back to the macOS Keychain, newer-wins by
  # expiresAt. Only updates an existing item, only for a real claudeAiOauth token.
  if command -v security >/dev/null 2>&1 \
     && [[ -s "${STATE_DIR}/.credentials.json" ]] \
     && grep -q '"claudeAiOauth"' "${STATE_DIR}/.credentials.json" 2>/dev/null; then
    local _state_exp _kc_exp=0 _kc_now _kc_acct
    _state_exp=$(_cred_expiry < "${STATE_DIR}/.credentials.json")
    if _kc_now=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) \
       && [[ "$_kc_now" == *claudeAiOauth* ]]; then
      _kc_exp=$(printf '%s' "$_kc_now" | _cred_expiry)
    fi
    _kc_acct=$(security find-generic-password -s "Claude Code-credentials" 2>/dev/null \
      | sed -n 's/^[[:space:]]*"acct"<blob>="\(.*\)"$/\1/p')
    if [[ -n "$_kc_acct" && "${_state_exp:-0}" -gt "${_kc_exp:-0}" ]]; then
      security add-generic-password -U -s "Claude Code-credentials" -a "$_kc_acct" \
        -w "$(cat "${STATE_DIR}/.credentials.json")" 2>/dev/null \
        && log "synced refreshed Claude token back to Keychain" || true
    fi
  fi

  # Copy sessions to the host's Claude project dir for cross-tool resumability,
  # preserving mtimes so the resume hint picks the just-closed session correctly.
  cp -pf "${_state_proj}/"*.jsonl "$HOST_PROJECT_SESSIONS/" 2>/dev/null
  cp -prf "${_state_proj}/"*/ "$HOST_PROJECT_SESSIONS/" 2>/dev/null

  # Resume hint: newest transcript by mtime across the state dir and host dir,
  # skipping agent-*.jsonl subagent sidechains.
  local _latest="" f _id _resume_cmd
  for f in "${_state_proj}/"*.jsonl "${HOST_PROJECT_SESSIONS}/"*.jsonl; do
    [[ -f "$f" ]] || continue
    case "${f##*/}" in agent-*) continue ;; esac
    [[ -z "$_latest" || "$f" -nt "$_latest" ]] && _latest="$f"
  done
  if [[ -n "$_latest" ]]; then
    _id=$(basename "$_latest" .jsonl)
    _resume_cmd="claude-box -r ${_id}"
    printf '[claude-box] to resume: %s\n' "$_resume_cmd" >&2
    printf '%s\n' "$_resume_cmd" > "${_state_proj}/.last-resume" 2>/dev/null || true
  fi
}

cage_run "$@"
