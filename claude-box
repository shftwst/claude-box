#!/usr/bin/env bash
# claude-box — run Claude Code in Docker with --dangerously-skip-permissions
#
# Mounts the project dir at its exact host path so skill symlinks resolve.
# Persists Claude Code state (settings, conversations) in ~/.claude-box/state/
# across runs — delete that dir to reset.
# Syncs ~/.claude skills, plugins, hooks, and .mcp.json into the
# container so your local setup is always reflected.
# Sessions for the current project are written to ~/.claude/projects/<slug>/
# on the host so they're resumable from host Claude as well as future
# claude-box runs in the same project. Session-keyed satellite state (todos,
# shell env, pastes, plans, file-history) is also shared so resume preserves
# more than just the transcript.
#
# Usage:
#   claude-box                  # interactive session in current directory
#   claude-box /path/to/dir     # interactive session in another directory
#   claude-box . -c             # continue most recent session here
#   claude-box . --resume       # pick a session to resume (interactive picker)
#   claude-box . -r <id>        # resume a specific session by ID
#   claude-box . -p "..."       # non-interactive prompt (pipe-friendly)
#
# claude-box-specific flags (consumed before claude sees them; position-free):
#   --no-ssh                    # skip ~/.ssh mount and SSH_AUTH_SOCK forwarding
#                                 (signing/git-over-ssh disabled inside container)
#   --upgrade                   # git pull the claude-box install dir and exit
#                                 (next run rebuilds the image if needed)
#
# Installation:
#   git clone https://github.com/shftwst/claude-box ~/claude-box
#   ln -sf ~/claude-box/claude-box /usr/local/bin/claude-box
#   # or add ~/claude-box to PATH

set -euo pipefail

# Progress logs to stderr, gated on a tty so piped/non-interactive runs stay clean.
log() { [[ -t 2 ]] && printf '[claude-box] %s\n' "$*" >&2; }

# Background-check the install dir against its upstream. Detached so the parent
# never waits and silent on every failure mode (not a repo, no upstream,
# offline, fetch fails) — those skips don't touch $UPDATE_CHECK_FILE so we
# retry next launch instead of going dark for 24h on a transient blip.
check_for_update_in_background() {
  (
    cd "$CLAUDE_BOX_DIR" || exit 0
    git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || exit 0
    git fetch --quiet 2>/dev/null || exit 0
    if [[ $(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0) -gt 0 ]]; then
      touch "$UPDATE_AVAILABLE_FILE"
    else
      rm -f "$UPDATE_AVAILABLE_FILE"
    fi
    touch "$UPDATE_CHECK_FILE"
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# Pull claude-box's own flags out of "$@" before anything else looks at args,
# so the project-dir positional and the claude-flag passthrough stay clean.
NO_SSH=0
UPGRADE=0
declare -a _passthrough=()
for arg in "$@"; do
  case "$arg" in
    --no-ssh) NO_SSH=1 ;;
    --upgrade) UPGRADE=1 ;;
    *) _passthrough+=("$arg") ;;
  esac
done
set -- "${_passthrough[@]+"${_passthrough[@]}"}"

# Resolve symlinks so installs via `ln -sf ~/claude-box/claude-box /usr/local/bin/`
# (or homebrew's /opt/homebrew/bin) still find the Dockerfile in the repo dir.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self")
  [[ "$_link" = /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
CLAUDE_BOX_DIR="$(cd "$(dirname "$_self")" && pwd)"

UPDATE_CHECK_FILE="${HOME}/.claude-box/.last-update-check"
UPDATE_AVAILABLE_FILE="${HOME}/.claude-box/.update-available"
mkdir -p "${HOME}/.claude-box"

# --upgrade: pull latest claude-box and exit. Next regular run picks up any
# Dockerfile/entrypoint changes via the mtime-vs-BUILT_MARKER check below.
# Uses --ff-only so a dirty install dir errors out instead of silently merging.
if [[ $UPGRADE -eq 1 ]]; then
  log "upgrading claude-box at ${CLAUDE_BOX_DIR}..."
  if git -C "$CLAUDE_BOX_DIR" pull --ff-only; then
    rm -f "$UPDATE_AVAILABLE_FILE"
    touch "$UPDATE_CHECK_FILE"
    exit 0
  else
    exit $?
  fi
fi

# Show cached update hint (zero-latency: just a file-existence check).
[[ -e "$UPDATE_AVAILABLE_FILE" ]] && \
  log "update available — run 'claude-box --upgrade' to pull latest"

# If our cached check is missing or >24h old, kick off a fresh check in the
# background. `find -mtime -1` is portable across BSD (macOS) and GNU find.
if [[ ! -f "$UPDATE_CHECK_FILE" ]] || \
   [[ -z "$(find "$UPDATE_CHECK_FILE" -mtime -1 2>/dev/null)" ]]; then
  check_for_update_in_background
fi

PROJECT_DIR="$(cd "${1:-$PWD}" && pwd)"

# Refuse to launch from $HOME (or any ancestor of it). PROJECT_DIR is
# bind-mounted into the container, so launching from home would mount your
# entire home directory into the box — a huge attack surface and a lot of
# virtiofs traffic — and make ${HOME} a virtiofs mount root the entrypoint
# can't chown (which used to kill the container outright). Runs before any
# trap/launch, so a bare exit here is clean.
_home="$(cd "$HOME" 2>/dev/null && pwd)"
if [[ -n "$_home" && ( "$PROJECT_DIR" == "$_home" || "$_home" == "$PROJECT_DIR"/* ) ]]; then
  printf '[claude-box] refusing to launch from %s\n' "$PROJECT_DIR" >&2
  printf '[claude-box] this would bind-mount your entire home directory (%s) into the box.\n' "$_home" >&2
  printf '[claude-box] cd into a specific project directory and run claude-box from there.\n' >&2
  exit 1
fi

CLAUDE_HOME="${HOME}/.claude"
IMAGE="claude-box"
DOCKERFILE="${CLAUDE_BOX_DIR}/Dockerfile"
ENTRYPOINT_SH="${CLAUDE_BOX_DIR}/entrypoint.sh"
BUILT_MARKER="${HOME}/.claude-box/.built"

CONTAINER_NAME="claude-box-$(basename "$PROJECT_DIR")-$$"

# Build the image if it doesn't exist or any build input has changed. Includes
# entrypoint.sh because it's COPYed into the image, so changes there need a
# rebuild even when the Dockerfile itself is unchanged.
needs_build=0
if ! docker image inspect "$IMAGE" &>/dev/null; then
  needs_build=1
elif [[ "$DOCKERFILE" -nt "$BUILT_MARKER" || "$ENTRYPOINT_SH" -nt "$BUILT_MARKER" ]]; then
  needs_build=1
fi
if [[ $needs_build -eq 1 ]]; then
  log "building image..."
  docker build -f "$DOCKERFILE" -t "$IMAGE" "$CLAUDE_BOX_DIR"
  mkdir -p "$(dirname "$BUILT_MARKER")"
  touch "$BUILT_MARKER"
fi

# Persistent state dir — preserves settings, conversation history, etc. across
# runs so Claude Code doesn't re-run setup on every launch. Delete to reset.
STATE_DIR="${HOME}/.claude-box/state"
mkdir -p "$STATE_DIR"
chmod 777 "$STATE_DIR"

_SSH_RELAY_PID=""
cleanup() {
  if [[ -n "$_SSH_RELAY_PID" ]]; then
    kill "$_SSH_RELAY_PID" 2>/dev/null || true
    wait "$_SSH_RELAY_PID" 2>/dev/null || true
  fi
}

# First positional arg names the project (defaults to "."); captured here so the
# resume hint in sync_back() — where $1 would be the function's arg, not the
# script's — still prints the dir the user launched with.
_PROJECT_ARG="${1:-.}"

# Flush sessions, credentials, and satellite state from the container back to the
# host, write any refreshed token back to the Keychain, and print the resume
# hint. Runs from the EXIT trap (and via the signal traps below), so a DROPPED
# session — terminal/SSH close, sleep, kill — flushes to the host's native Claude
# dir and gets the Colima virtiofs coherence pass exactly like a clean exit,
# instead of stranding the transcript in the state dir. The helper container
# works over the state volume, so it doesn't need the (already --rm'd) session
# container. Guarded to run at most once, and only if the container was launched.
_LAUNCHED=0
_SYNCED=0
sync_back() {
  [[ "${_LAUNCHED:-0}" == 1 && "${_SYNCED:-0}" == 0 ]] || return 0
  _SYNCED=1
  set +euo pipefail
  _state_proj="${STATE_DIR}/projects/${PROJECT_SLUG}"

  # On Colima, files written by the container may not be visible on the host due
  # to virtiofs caching. Copy them out through Docker's I/O path via a helper
  # container — the host can't see them directly.
  if [[ "${DOCKER_HOST:-}" == */.colima/* ]]; then
    log "syncing state back from colima..."
    _cid=$(docker create --entrypoint sleep -v "${STATE_DIR}:/_state:rw" "${IMAGE}" 1 2>/dev/null)
    if [[ -n "$_cid" ]]; then
      # Sessions, .claude.json, credentials, and satellite state (tasks, todos, etc.)
      docker cp "${_cid}:/_state/projects/${PROJECT_SLUG}/." "${_state_proj}/" 2>/dev/null || true
      docker cp "${_cid}:/_state/.claude.json" "${STATE_DIR}/.claude.json" 2>/dev/null || true
      docker cp "${_cid}:/_state/.credentials.json" "${STATE_DIR}/.credentials.json" 2>/dev/null || true
      for _sat in tasks session-env shell-snapshots paste-cache plans file-history; do
        docker cp "${_cid}:/_state/${_sat}/." "${STATE_DIR}/${_sat}/" 2>/dev/null || true
      done
      docker rm -f "$_cid" >/dev/null 2>&1 || true
    fi
  fi

  # Write an in-box token refresh back to the macOS Keychain so host Claude — and
  # the next launch's seed — pick it up instead of re-seeding a now-rotated (dead)
  # refresh token, the usual cause of intermittent logouts. Newer-wins by
  # expiresAt so a concurrent host refresh isn't clobbered. Only updates an
  # existing Keychain item (never creates a duplicate) and only for a real
  # claudeAiOauth token.
  if command -v security >/dev/null 2>&1 \
     && [[ -s "${STATE_DIR}/.credentials.json" ]] \
     && grep -q '"claudeAiOauth"' "${STATE_DIR}/.credentials.json" 2>/dev/null; then
    _state_exp=$(_cred_expiry < "${STATE_DIR}/.credentials.json")
    _kc_exp=0
    if _kc_now=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) \
       && [[ "$_kc_now" == *claudeAiOauth* ]]; then
      _kc_exp=$(printf '%s' "$_kc_now" | _cred_expiry)
    fi
    _kc_acct=$(security find-generic-password -s "Claude Code-credentials" 2>/dev/null \
      | sed -n 's/^[[:space:]]*"acct"<blob>="\(.*\)"$/\1/p')
    if [[ -n "$_kc_acct" && "${_state_exp:-0}" -gt "${_kc_exp:-0}" ]]; then
      security add-generic-password -U -s "Claude Code-credentials" -a "$_kc_acct" \
        -w "$(cat "${STATE_DIR}/.credentials.json")" 2>/dev/null \
        && log "synced refreshed Claude token back to Keychain" || true
    fi
  fi

  # Copy sessions to the host's Claude project dir for cross-tool resumability.
  # Preserve mtimes (-p): the resume hint below picks the just-closed session by
  # newest mtime, and a plain cp stamps every file with the copy time — which
  # collapses all sessions to one timestamp and makes the pick arbitrary (it
  # falls back to glob/alphabetical order, reporting a stale unrelated session).
  cp -pf "${_state_proj}/"*.jsonl "$HOST_PROJECT_SESSIONS/" 2>/dev/null
  cp -prf "${_state_proj}/"*/ "$HOST_PROJECT_SESSIONS/" 2>/dev/null

  # Resume hint: the just-closed session is the newest transcript by mtime. Scan
  # both the synced state dir (authoritative on Colima — docker cp keeps real
  # mtimes) and the host dir (where the live override-mount writes on other
  # runtimes) so whichever holds the real session wins even if one copy missed —
  # that double source is also why the hint still prints on a fresh project when
  # only one of the two dirs got populated. Skip agent-*.jsonl: those are
  # subagent sidechains, not resumable sessions.
  _latest=""
  for f in "${_state_proj}/"*.jsonl "${HOST_PROJECT_SESSIONS}/"*.jsonl; do
    [[ -f "$f" ]] || continue
    case "${f##*/}" in agent-*) continue ;; esac
    [[ -z "$_latest" || "$f" -nt "$_latest" ]] && _latest="$f"
  done
  if [[ -n "$_latest" ]]; then
    _id=$(basename "$_latest" .jsonl)
    _resume_cmd="claude-box ${_PROJECT_ARG} -r ${_id}"
    printf '[claude-box] to resume: %s\n' "$_resume_cmd" >&2
    # Also persist the hint: a dropped session (terminal/SSH closed) runs this
    # trap with a stderr that's already gone, so the line above is computed and
    # lost. Stash it so the next launch in this project can surface it.
    printf '%s\n' "$_resume_cmd" > "${_state_proj}/.last-resume" 2>/dev/null || true
  fi
}

# Run sync_back on any exit, and convert a closed terminal (HUP), kill (TERM), or
# Ctrl-C during the sync phase (INT) into a graceful exit so it still fires. A
# pending signal trap runs the instant `docker run` returns, so sync_back must
# already be defined by then — hence it lives here, above the run. During the
# interactive `docker run -it` the PTY is in raw mode, so the user's in-Claude
# Ctrl-C goes to the container, not to this launcher.
trap 'sync_back; cleanup' EXIT
trap 'exit' INT TERM HUP

# Per-project overrides: source ${PROJECT_DIR}/.env.claude-box if present so
# each project can supply its own values (e.g. a project-specific LINEAR_API_KEY)
# without having to re-export them in the calling shell. Sourced BEFORE
# FORWARD_VARS is built so the file can also extend CLAUDE_BOX_EXTRA_VARS.
# Values here win over whatever's in the host shell. set -a auto-exports each
# assignment so plain KEY=value lines work without needing `export`.
PROJECT_ENV_FILE="${PROJECT_DIR}/.env.claude-box"
if [[ -f "$PROJECT_ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$PROJECT_ENV_FILE"
  set +a
fi

# Env vars to forward into the container.
# Add project-specific vars by setting CLAUDE_BOX_EXTRA_VARS, either in your
# shell before invoking or inside the project's .env.claude-box:
#   CLAUDE_BOX_EXTRA_VARS=(TURSO_AUTH_TOKEN MY_API_KEY) claude-box
# Forward TERM + COLORFGBG only if the host shell has them set — don't synthesize
# defaults. Claude Code's theme auto-detect works correctly when the container
# inherits exactly what iTerm2 (or whatever terminal) provides, and synthesizing
# values has surprising side effects.
# Specifically, do NOT set COLORTERM=truecolor in the docker run env — even
# though the terminal supports it, forcing it in the container causes Claude
# Code's palette derivation to pick a broken combo (white-on-white prompt and
# response text). Let the terminal advertise its own capabilities through
# whatever vars iTerm2 already exports.
FORWARD_VARS=(
  ANTHROPIC_API_KEY
  GITHUB_TOKEN
  GITHUB_PERSONAL_ACCESS_TOKEN
  LINEAR_API_KEY
  TERM
  COLORFGBG
  "${CLAUDE_BOX_EXTRA_VARS[@]+"${CLAUDE_BOX_EXTRA_VARS[@]}"}"
)

env_args=()
for var in "${FORWARD_VARS[@]}"; do
  [[ -n "${!var:-}" ]] && env_args+=(-e "${var}=${!var}")
done

# Concatenate CLAUDE.md files: global base → parent dirs → project (project wins).
# Written directly into the state dir so it's part of the main volume mount —
# no separate bind mount that could fail on Colima when virtiofs hasn't synced.
: > "${STATE_DIR}/CLAUDE.md"

if [[ -f "${CLAUDE_HOME}/CLAUDE.md" ]]; then
  cat "${CLAUDE_HOME}/CLAUDE.md" >> "${STATE_DIR}/CLAUDE.md"
fi

declare -a claude_files=()
current="$PROJECT_DIR"
while [[ "$current" != "/" ]]; do
  [[ -f "$current/CLAUDE.md" ]] && claude_files+=("$current/CLAUDE.md")
  current="$(dirname "$current")"
done

for (( i=${#claude_files[@]}-1; i>=0; i-- )); do
  f="${claude_files[$i]}"
  printf '\n<!-- %s -->\n' "$f" >> "${STATE_DIR}/CLAUDE.md"
  cat "$f" >> "${STATE_DIR}/CLAUDE.md"
done

# Specific ~/.claude entries to bind-mount on top of the state volume.
# Pre-create the mount-point directories/files as host-user-owned so Docker
# doesn't create them as root (which would leave root-owned paths in STATE_DIR
# that the cleanup trap can't delete).
# Extract gh CLI token from the host (keychain-backed on macOS) and forward it
# as GH_TOKEN so `gh` works inside the container without re-authing.
if [[ -z "${GH_TOKEN:-}" ]]; then
  log "fetching gh auth token..."
  GH_TOKEN=$(gh auth token 2>/dev/null) && env_args+=(-e "GH_TOKEN=${GH_TOKEN}") || true
fi

declare -a override_mounts=()

# Mount SSH keys + forward ssh-agent so git-over-SSH and signing work inside
# the container. Agent forwarding means the host's already-unlocked key is used
# directly — no passphrase prompt per commit. Skipped if --no-ssh was passed.
#
# macOS socket paths vary by runtime:
#   - Docker Desktop: can't bind-mount /private/tmp/com.apple.launchd.* sockets
#     but exposes a magic /run/host-services/ssh-auth.sock proxy.
#   - Colima: virtiofs can't expose Unix sockets at all. We relay the host agent
#     over TCP (Python on host → socat in container) so the container gets a
#     working SSH_AUTH_SOCK without needing the VM to see the socket file.
#   - OrbStack: full macOS filesystem access, all paths work directly.
# 1Password's socket (~/.1password/agent.sock) is under $HOME and works everywhere.
if [[ $NO_SSH -eq 0 ]]; then
  [[ -d "${HOME}/.ssh" ]] && override_mounts+=(-v "${HOME}/.ssh:${HOME}/.ssh:ro")
  if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
    if [[ "${DOCKER_HOST:-}" == */.colima/* ]]; then
      # Colima: start a TCP relay on the host that proxies to the agent socket.
      # The container's entrypoint converts it back to a Unix socket via socat.
      # We write the port to a temp file instead of capturing stdout via $()
      # because $(cmd &) hangs waiting for the pipe to drain and $! inside $()
      # doesn't propagate to the parent shell.
      _relay_port_file=$(mktemp /tmp/claude-box-relay.XXXXXX)
      python3 -c "
import socket, sys, threading, signal, os
src = '${SSH_AUTH_SOCK}'
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(('127.0.0.1', 0))
port = server.getsockname()[1]
with open('${_relay_port_file}', 'w') as f:
    f.write(str(port))
server.listen(8)
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
def relay(a, b):
    try:
        while d := a.recv(4096): b.sendall(d)
    except: pass
    finally: a.close(); b.close()
while True:
    c, _ = server.accept()
    u = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    u.connect(src)
    threading.Thread(target=relay, args=(c, u), daemon=True).start()
    threading.Thread(target=relay, args=(u, c), daemon=True).start()
" &
      _SSH_RELAY_PID=$!
      # Poll until the relay writes its port (up to 3 s). A fixed sleep raced
      # against Python startup — if the read beat the write, the container got
      # an empty CLAUDE_BOX_SSH_RELAY_PORT and no SSH_AUTH_SOCK.
      _RELAY_PORT=""
      for _i in $(seq 1 30); do
        [[ -s "$_relay_port_file" ]] && { _RELAY_PORT=$(<"$_relay_port_file"); break; }
        sleep 0.1
      done
      rm -f "$_relay_port_file"
      if [[ -z "$_RELAY_PORT" ]]; then
        log "warning: SSH agent relay failed to start — signing will not work"
        kill "$_SSH_RELAY_PID" 2>/dev/null || true
        _SSH_RELAY_PID=""
      else
        env_args+=(-e "CLAUDE_BOX_SSH_RELAY_PORT=${_RELAY_PORT}")
        env_args+=(--add-host "host.docker.internal:host-gateway")
      fi
    elif [[ "$SSH_AUTH_SOCK" == /private/tmp/com.apple.launchd.* ]]; then
      # Docker Desktop can't mount launchd sockets — use its built-in proxy
      override_mounts+=(-v "/run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock")
      env_args+=(-e "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock")
    else
      # OrbStack and Linux: mount the socket directly
      override_mounts+=(-v "${SSH_AUTH_SOCK}:${SSH_AUTH_SOCK}")
      env_args+=(-e "SSH_AUTH_SOCK=${SSH_AUTH_SOCK}")
    fi
  fi
else
  log "ssh disabled (--no-ssh): no key mount, no agent forwarding"
fi

# Mount host ~/.gitconfig read-only so user name/email, aliases, signing config,
# etc. carry into the container. On Colima, copy into state dir instead (virtiofs
# can't see single host files reliably for bind mounts).
if [[ -f "${HOME}/.gitconfig" ]]; then
  if [[ "${DOCKER_HOST:-}" == */.colima/* ]]; then
    cp -f "${HOME}/.gitconfig" "${STATE_DIR}/.gitconfig" 2>/dev/null || true
  else
    override_mounts+=(-v "${HOME}/.gitconfig:${HOME}/.gitconfig:ro")
  fi
fi

# Share XDG cache (pip wheels, npm/yarn tarballs, playwright browsers, etc.) so
# first-run downloads survive container exit and are shared across boxes.
# mkdir -p so Docker doesn't create a root-owned dir on a host without ~/.cache.
mkdir -p "${HOME}/.cache"
override_mounts+=(-v "${HOME}/.cache:${HOME}/.cache")

# Share ~/.local/bin so tools installed inside the box (pip/uv --user, etc.)
# survive container exit. The entrypoint puts this on PATH. mkdir -p so Docker
# doesn't create a root-owned dir when the host has no ~/.local/bin yet.
mkdir -p "${HOME}/.local/bin"
override_mounts+=(-v "${HOME}/.local/bin:${HOME}/.local/bin")

# Per-project session sharing: bind-mount just this project's session dir from
# the host so sessions started in claude-box are resumable from host Claude
# (and vice versa). Scoped to the current project so other projects' history
# stays isolated in the state volume. Claude encodes project paths by replacing
# `/` with `-`; we mirror that to find the matching subdir.
PROJECT_SLUG="${PROJECT_DIR//\//-}"
HOST_PROJECT_SESSIONS="${CLAUDE_HOME}/projects/${PROJECT_SLUG}"
mkdir -p "$HOST_PROJECT_SESSIONS"
mkdir -p "${STATE_DIR}/projects/${PROJECT_SLUG}"

# Surface the previous run's resume hint if the last session was dropped — its
# stderr was gone when sync_back printed, so the line never reached the user.
# Show it once, then clear it so it doesn't linger across future launches.
_last_resume_file="${STATE_DIR}/projects/${PROJECT_SLUG}/.last-resume"
if [[ -s "$_last_resume_file" ]]; then
  log "last session: $(cat "$_last_resume_file")"
  rm -f "$_last_resume_file" 2>/dev/null || true
fi
# On Colima, skip the override mount — the freshly-created host dir isn't
# visible to the VM, so Docker creates an empty ephemeral directory instead.
# Sessions fall through to the state dir's projects folder, and we sync them
# back to the host after docker exits.
if [[ "${DOCKER_HOST:-}" != */.colima/* ]]; then
  override_mounts+=(-v "${HOST_PROJECT_SESSIONS}:${HOST_PROJECT_SESSIONS}")
fi

# Session-keyed satellite state. Each of these dirs holds one entry per session
# UUID (todos, shell env snapshots, pastes, plan-mode drafts, file-edit
# history). Sharing them with the host means a session started in claude-box
# resumes in host Claude — and vice versa — with full fidelity, not just the
# conversation transcript. Trade-off: because entries are keyed by session UUID
# (not project), the container can see satellite state for sessions from other
# projects. No corruption risk; UUIDs don't collide. mkdir -p so a fresh host
# without these dirs doesn't end up with root-owned mount points.
for entry in tasks session-env shell-snapshots paste-cache plans file-history; do
  mkdir -p "${CLAUDE_HOME}/${entry}"
  # On Colima, skip these override mounts — virtiofs can't see the host dirs.
  # The state dir already has these paths and they'll be synced back after exit.
  if [[ "${DOCKER_HOST:-}" != */.colima/* ]]; then
    override_mounts+=(-v "${CLAUDE_HOME}/${entry}:${CLAUDE_HOME}/${entry}")
  fi
done

# Per-project extra mounts. Set CLAUDE_BOX_EXTRA_MOUNTS in .env.claude-box (or
# the calling shell) to an array of host:container[:opts] specs, e.g.:
#   CLAUDE_BOX_EXTRA_MOUNTS=("$HOME/.aws:$HOME/.aws:ro" "/data:/data")
for spec in "${CLAUDE_BOX_EXTRA_MOUNTS[@]+"${CLAUDE_BOX_EXTRA_MOUNTS[@]}"}"; do
  override_mounts+=(-v "$spec")
done

# On non-Colima runtimes, overlay-mount host ~/.claude entries on top
# of the state dir so the container always reflects the host's current setup.
# On Colima, these mounts silently fail (virtiofs can't see the host dirs), so
# we skip them here and sync into the state dir later via host-side cp + flush.
if [[ "${DOCKER_HOST:-}" != */.colima/* ]]; then
  for entry in plugins skills hooks .mcp.json; do
    if [[ -e "${CLAUDE_HOME}/${entry}" ]]; then
      if [[ -d "${CLAUDE_HOME}/${entry}" ]]; then
        mkdir -p "${STATE_DIR}/${entry}"
      else
        touch "${STATE_DIR}/${entry}"
      fi
      override_mounts+=(-v "${CLAUDE_HOME}/${entry}:${CLAUDE_HOME}/${entry}:rw")
    fi
  done

  # Symlinked skills point to absolute paths outside ~/.claude (e.g. other repos).
  # Collect the unique parent dirs of all symlink targets and mount them rw
  # so those paths resolve inside the container and skills can be developed.
  log "resolving skill symlinks..."
  while IFS= read -r dir; do
    [[ -d "$dir" ]] && override_mounts+=(-v "${dir}:${dir}:rw")
  done < <(
    find "${CLAUDE_HOME}/skills" -maxdepth 1 -type l 2>/dev/null \
      | while IFS= read -r link; do
          target=$(readlink "$link" 2>/dev/null) && dirname "$target"
        done \
      | sort -u
  )
else
  log "resolving skill symlinks..."
fi
# Sync Claude OAuth credentials into the state dir, newer-wins. On macOS the
# canonical source is the Keychain ("Claude Code-credentials");
# ~/.claude/.credentials.json on macOS often holds only MCP OAuth state (no
# claudeAiOauth block), so trusting the file by existence alone overwrites a
# good state-dir token with garbage. The state token may also be FRESHER than
# the Keychain — an in-box /login or token refresh from a previous run (written
# back to the Keychain on exit, below). Access-token expiresAt is the recency
# proxy: whichever side refreshed most recently has the larger value, so we only
# overwrite the state token when the incoming copy is at least as new. If
# neither source yields a token, leave the state file alone.
#
# Echoes a claudeAiOauth credential's expiresAt (epoch ms) from stdin, else 0.
_cred_expiry() {
  node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);process.stdout.write(String((j.claudeAiOauth&&j.claudeAiOauth.expiresAt)||0))}catch{process.stdout.write("0")}})' 2>/dev/null || printf 0
}
log "reading Claude credentials..."
_state_cred="${STATE_DIR}/.credentials.json"
_state_exp=0
if [[ -s "$_state_cred" ]] && grep -q '"claudeAiOauth"' "$_state_cred" 2>/dev/null; then
  _state_exp=$(_cred_expiry < "$_state_cred")
fi
if KEYCHAIN_CRED=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) \
   && [[ "$KEYCHAIN_CRED" == *claudeAiOauth* ]]; then
  _kc_exp=$(printf '%s' "$KEYCHAIN_CRED" | _cred_expiry)
  if [[ "${_kc_exp:-0}" -ge "${_state_exp:-0}" ]]; then
    printf '%s\n' "$KEYCHAIN_CRED" > "$_state_cred"
  fi
elif [[ "${_state_exp:-0}" -eq 0 ]] && [[ -f "${CLAUDE_HOME}/.credentials.json" ]] \
     && grep -q '"claudeAiOauth"' "${CLAUDE_HOME}/.credentials.json" 2>/dev/null; then
  cp -f "${CLAUDE_HOME}/.credentials.json" "$_state_cred"
fi

# Sync host config files into the state dir.
# Only syncs when the host file is newer (first run, or after host update).
# Claude Code then reads/writes the state-dir copies, keeping container state
# independent of the host after the initial seed.

_sync_js="${TMPDIR:-/tmp}/claude-box-sync.$$.js"
cat > "$_sync_js" <<'JSEOF'
const fs = require('fs');
const [,, mode, src, dst] = process.argv;
const s = JSON.parse(fs.readFileSync(src, 'utf8'));
if (mode === 'passthrough') {
  // Pre-accept the bypass permissions dialog so --dangerously-skip-permissions
  // doesn't prompt every run.
  s.bypassPermissionsModeAccepted = true;
}
if (mode === 'settings') {
  delete s.sandbox;
  delete s.hooks;
  // Rewrite macOS bun path to container path so plugins like claude-hud work.
  if (s.statusLine && s.statusLine.command) {
    s.statusLine.command = s.statusLine.command.replace(/\/opt\/homebrew\/bin\/bun/g, '/usr/local/bin/bun');
  }
  // Use the claude-box theme so the container is visually distinct from host Claude.
  s.theme = 'custom:claude-box';
}
if (mode === 'statusline') {
  // Refresh ONLY the host's statusLine (the HUD) + theme into the existing state
  // copy, bun path rewritten — merging into, not replacing, the box's settings.
  // Runs every launch (bypassing the -nt seed guard) so a host statusLine still
  // reaches the box after Claude has rewritten the box's settings.json and made
  // it "newer" than the host. Mirrors the host: sets it when present, removes it
  // when absent. Bails without writing if the state file is unreadable, so a
  // transient parse error can't nuke the box's settings.
  let cur;
  try { cur = JSON.parse(fs.readFileSync(dst, 'utf8')); } catch { process.exit(0); }
  if (s.statusLine) {
    const sl = JSON.parse(JSON.stringify(s.statusLine));
    if (sl.command) sl.command = sl.command.replace(/\/opt\/homebrew\/bin\/bun/g, '/usr/local/bin/bun');
    cur.statusLine = sl;
  } else {
    delete cur.statusLine;
  }
  cur.theme = 'custom:claude-box';
  fs.writeFileSync(dst, JSON.stringify(cur, null, 2));
  process.exit(0);
}
fs.writeFileSync(dst, JSON.stringify(s, null, 2));
JSEOF

HOST_SETTINGS="${CLAUDE_HOME}/settings.json"
STATE_SETTINGS="${STATE_DIR}/settings.json"
if [[ -f "$HOST_SETTINGS" ]] && { [[ ! -f "$STATE_SETTINGS" ]] || [[ "$HOST_SETTINGS" -nt "$STATE_SETTINGS" ]]; }; then
  node "$_sync_js" settings "$HOST_SETTINGS" "$STATE_SETTINGS"
fi

# The HUD (statusLine) is host-derived presentation config, so refresh it from
# the host on EVERY launch — not just on the -nt seed above. Claude rewrites the
# box's settings.json during a session (theme/model/config), making the state
# copy permanently "newer" than the host; without this, a host statusLine added
# or changed afterwards never reaches the box and the HUD silently disappears.
if [[ -f "$HOST_SETTINGS" && -f "$STATE_SETTINGS" ]]; then
  node "$_sync_js" statusline "$HOST_SETTINGS" "$STATE_SETTINGS"
fi

HOST_CLAUDE_JSON="${HOME}/.claude.json"
STATE_CLAUDE_JSON="${STATE_DIR}/.claude.json"
if [[ -f "$HOST_CLAUDE_JSON" ]] && { [[ ! -f "$STATE_CLAUDE_JSON" ]] || [[ "$HOST_CLAUDE_JSON" -nt "$STATE_CLAUDE_JSON" ]]; }; then
  node "$_sync_js" passthrough "$HOST_CLAUDE_JSON" "$STATE_CLAUDE_JSON"
fi

rm -f "$_sync_js"

# Ensure all bind-mount source files exist as actual files. Docker auto-creates
# nonexistent sources as root-owned directories, which persists in the state dir
# and breaks subsequent runs (especially on Colima).
for _f in "$STATE_CLAUDE_JSON" "${STATE_DIR}/CLAUDE.md" "${STATE_DIR}/settings.json" \
          "${STATE_DIR}/.credentials.json"; do
  [[ -d "$_f" ]] && rm -rf "$_f"
  [[ ! -f "$_f" ]] && touch "$_f"
done

# Colima's virtiofs cache may not expose freshly-written host files to the VM
# in time for bind mounts. Flush volatile state files through Docker's I/O path
# by tar-piping them into a lightweight container that writes to the same volume,
# warming the VM's filesystem cache. Other runtimes skip this — they share the
# full host filesystem without caching issues.
if [[ "${DOCKER_HOST:-}" == */.colima/* ]]; then
  # Sync host ~/.claude entries (plugins, skills, hooks, .mcp.json) into the
  # state dir. Overlay mounts from the host fail on Colima (virtiofs can't see
  # host-written dirs), so everything must be in the state dir volume.
  log "syncing host config for colima..."
  for _sync_entry in plugins skills hooks; do
    if [[ -d "${CLAUDE_HOME}/${_sync_entry}" ]]; then
      mkdir -p "${STATE_DIR}/${_sync_entry}"
      rsync -aL --delete "${CLAUDE_HOME}/${_sync_entry}/" "${STATE_DIR}/${_sync_entry}/" 2>/dev/null || \
        cp -rfL "${CLAUDE_HOME}/${_sync_entry}/." "${STATE_DIR}/${_sync_entry}/" 2>/dev/null || true
    fi
  done
  [[ -f "${CLAUDE_HOME}/.mcp.json" ]] && cp -f "${CLAUDE_HOME}/.mcp.json" "${STATE_DIR}/.mcp.json" 2>/dev/null || true

  # Inbound session seeding (host -> state). The live override mounts for the
  # project sessions dir and the satellite-state dirs are skipped on Colima, and
  # the post-exit sync only copies state -> host. Without this, a session that
  # exists on the host — created by host Claude, by a prior box run, or copied
  # in by hand — is invisible inside the box. Seed newer-wins (no --delete, so
  # it unions rather than mirrors) so an in-box-newer session isn't clobbered by
  # a stale host copy; the flush below carries the result into the VM.
  log "seeding host sessions for colima..."
  if [[ -d "$HOST_PROJECT_SESSIONS" ]]; then
    rsync -au "${HOST_PROJECT_SESSIONS}/" "${STATE_DIR}/projects/${PROJECT_SLUG}/" 2>/dev/null || \
      cp -ru "${HOST_PROJECT_SESSIONS}/." "${STATE_DIR}/projects/${PROJECT_SLUG}/" 2>/dev/null || true
  fi
  for _seed_sat in tasks session-env shell-snapshots paste-cache plans file-history; do
    if [[ -d "${CLAUDE_HOME}/${_seed_sat}" ]]; then
      mkdir -p "${STATE_DIR}/${_seed_sat}"
      rsync -au "${CLAUDE_HOME}/${_seed_sat}/" "${STATE_DIR}/${_seed_sat}/" 2>/dev/null || \
        cp -ru "${CLAUDE_HOME}/${_seed_sat}/." "${STATE_DIR}/${_seed_sat}/" 2>/dev/null || true
    fi
  done

  # Flush the entire state dir through Docker I/O so the VM sees everything —
  # both the files we just synced and the volatile files (credentials, settings).
  log "flushing state for colima..."
  tar --no-xattrs -cf - -C "${STATE_DIR}" . 2>/dev/null \
    | docker run --rm -i --entrypoint tar -v "${STATE_DIR}:/_state" "${IMAGE}" --no-same-owner -xf - -C /_state 2>/dev/null || true
fi

# Mount .claude.json (main state) into the container at the home dir level
override_mounts+=(-v "${STATE_CLAUDE_JSON}:${HOME}/.claude.json")

# Set the terminal tab/window title to the project name so it's obvious which
# box this tab belongs to (otherwise it just shows "bash" or "docker"). OSC 0
# sets both icon name and window title — supported by iTerm2, Terminal.app,
# gnome-terminal, kitty, alacritty, tmux, etc. Gated on stderr being a tty so
# piped/non-interactive runs don't leak escape codes. The parent shell's
# prompt hook normally restores its own title after we exit.
if [[ -t 2 ]]; then
  printf '\e]0;claude-box: %s\a' "$(basename "$PROJECT_DIR")" >&2
fi

# Allocate a PTY (-t) whenever any of stdin/stdout/stderr is a real TTY. Claude
# Code's Ink-rendered TUI needs the container's stdout to be a PTY for color +
# layout detection; without it the welcome banner and status line render as
# white-on-white with raw ANSI artifacts. Drop -t only in fully piped/autonomous
# runs (no TTY anywhere) so docker doesn't inject CRLF translation that mangles
# stdout pipes.
TTY_FLAGS=(-i)
if [[ -t 0 || -t 1 || -t 2 ]]; then
  TTY_FLAGS+=(-t)
fi

# Mount order matters: state volume first, then specific overrides shadow it
# for the paths that need to reflect the host (settings, skills, CLAUDE.md).
# Entrypoint runs as root, creates a hostuser for HOST_UID, then drops to it.
log "starting container..."
_LAUNCHED=1
docker run --rm "${TTY_FLAGS[@]}" \
  --name "$CONTAINER_NAME" \
  -e "HOST_UID=$(id -u)" \
  -e "HOST_GID=$(id -g)" \
  -e "HOME=${HOME}" \
  -e "SKIP_NPM_PACKAGES_INSTALL=1" \
  -e "GIT_CONFIG_COUNT=3" \
  -e "GIT_CONFIG_KEY_0=safe.directory" \
  -e "GIT_CONFIG_VALUE_0=*" \
  -e "GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf" \
  -e "GIT_CONFIG_VALUE_1=git@github.com:" \
  -e "GIT_CONFIG_KEY_2=credential.helper" \
  -e "GIT_CONFIG_VALUE_2=!gh auth git-credential" \
  -v "${PROJECT_DIR}:${PROJECT_DIR}" \
  -v "${STATE_DIR}:${CLAUDE_HOME}" \
  ${override_mounts[@]+"${override_mounts[@]}"} \
  -v /var/run/docker.sock:/var/run/docker.sock \
  ${env_args[@]+"${env_args[@]}"} \
  -w "${PROJECT_DIR}" \
  "$IMAGE" \
  --dangerously-skip-permissions "${@:2}" || true

# The session/credential flush + resume hint run from the EXIT trap (sync_back,
# defined above), so they fire on a dropped session too — not just a clean exit.
